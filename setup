#!/bin/bash
# setup — Install GStack + GSD + Superpowers integrated workflow
# Run from the repo root: ./setup

set -e

CLAUDE_DIR="$HOME/.claude"
SKILLS_DIR="$CLAUDE_DIR/skills"

echo "=== GStack + GSD + Superpowers Workflow Setup ==="
echo ""

# 1. Copy execute-phase skill
echo "[1/3] Installing execute-phase skill..."
mkdir -p "$SKILLS_DIR/execute-phase"
cp skills/execute-phase/skill.md "$SKILLS_DIR/execute-phase/skill.md"
echo "  → ~/.claude/skills/execute-phase/skill.md"

# 2. Copy run-phases.sh
echo "[2/3] Installing run-phases.sh..."
cp scripts/run-phases.sh "$CLAUDE_DIR/run-phases.sh"
chmod +x "$CLAUDE_DIR/run-phases.sh"
echo "  → ~/.claude/run-phases.sh"

# 3. Add brainstorm routing rule to CLAUDE.md
echo "[3/3] Configuring brainstorm routing in CLAUDE.md..."
CLAUDE_MD="$CLAUDE_DIR/CLAUDE.md"
if grep -q "Brainstorm 路由" "$CLAUDE_MD" 2>/dev/null; then
  echo "  → Already configured, skipping"
else
  # Insert before @RTK.md line if it exists, otherwise append
  if grep -q "@RTK.md" "$CLAUDE_MD" 2>/dev/null; then
    sed -i '' "/@RTK.md/i\\
\\
## Brainstorm 路由\\
\\
- 任何需要 brainstorm 的请求，默认使用 GStack 多角色流程（调用 GStack 相关技能或命令）\\
- 仅当用户明确说「使用 superpowers brainstorm」或「用 sp brainstorm」时，才调用 superpowers:brainstorming skill\\
- GStack 执行完成后，等待用户 review 并 approve 设计文档，再进入 GSD phase 分解步骤\\
" "$CLAUDE_MD"
  else
    cat >> "$CLAUDE_MD" << 'EOF'

## Brainstorm 路由

- 任何需要 brainstorm 的请求，默认使用 GStack 多角色流程（调用 GStack 相关技能或命令）
- 仅当用户明确说「使用 superpowers brainstorm」或「用 sp brainstorm」时，才调用 superpowers:brainstorming skill
- GStack 执行完成后，等待用户 review 并 approve 设计文档，再进入 GSD phase 分解步骤
EOF
  fi
  echo "  → Added routing rule to ~/.claude/CLAUDE.md"
fi

echo ""
echo "=== Setup complete ==="
echo ""
echo "Prerequisites (install separately if not already done):"
echo "  GStack:    git clone --depth 1 https://github.com/garrytan/gstack.git ~/.claude/skills/gstack && cd ~/.claude/skills/gstack && ./setup"
echo "  GSD:       npm install -g get-shit-done-cc"
echo "  RalphLoop: pipx install ralph-py-cli"
echo ""
echo "Usage:"
echo "  1. Brainstorm (auto-triggered via GStack)"
echo "  2. /gsd  — decompose into phases"
echo "  3. ~/.claude/run-phases.sh <project-path>  — unattended execution"
